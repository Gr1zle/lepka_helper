"backend.community.ProgressInput" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>backend.community.ProgressInput</B></TD></TR><TR><TD ALIGN="LEFT">checkedMaterials : list[int]<BR ALIGN="LEFT"/>completedSteps : list[int]<BR ALIGN="LEFT"/>isCompleted : bool<BR ALIGN="LEFT"/>lastStep : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">&#160;</TD></TR></TABLE>>];
"backend.community.ActionInput" -> "backend.community.CommunityInput" [arrowhead="empty", arrowtail="none"];
