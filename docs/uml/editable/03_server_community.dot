digraph UML {
graph [rankdir=LR, charset="UTF-8", bgcolor="white", fontname="DejaVu Sans", fontsize=16, labelloc=t, label="API: публикации и комментарии", pad="0.22", nodesep="0.25", ranksep="0.55", splines=polyline, dpi=300];
node [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#111827", penwidth=1.1];
edge [fontname="DejaVu Sans", fontsize=9, color="#334155", fontcolor="#111827", penwidth=1.1];
"backend.community.ActionInput" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>backend.community.ActionInput</B></TD></TR><TR><TD ALIGN="LEFT">kind : str<BR ALIGN="LEFT"/>payload : dict<BR ALIGN="LEFT"/>requestId : str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">&#160;</TD></TR></TABLE>>];
