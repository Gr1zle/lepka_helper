"backend.community.CommentTextInput" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>backend.community.CommentTextInput</B></TD></TR><TR><TD ALIGN="LEFT">commentText : str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">&#160;</TD></TR></TABLE>>];
"backend.community.CommunityBodyLimit" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>backend.community.CommunityBodyLimit</B></TD></TR><TR><TD ALIGN="LEFT">app<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">__call__(scope, receive, send)<BR ALIGN="LEFT"/>__init__(app)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"backend.community.CommunityInput" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>backend.community.CommunityInput</B><BR/>base: BaseModel [external]</TD></TR><TR><TD ALIGN="LEFT">model_config<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">&#160;</TD></TR></TABLE>>];
"backend.community.PhotoInput" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>backend.community.PhotoInput</B></TD></TR><TR><TD ALIGN="LEFT">imageBase64 : str<BR ALIGN="LEFT"/>name : str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">&#160;</TD></TR></TABLE>>];
