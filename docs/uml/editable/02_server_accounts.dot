digraph UML {
graph [rankdir=LR, charset="UTF-8", bgcolor="white", fontname="DejaVu Sans", fontsize=16, labelloc=t, label="API: авторизация и аккаунт", pad="0.22", nodesep="0.25", ranksep="0.55", splines=polyline, dpi=300];
