digraph UML {
graph [rankdir=LR, charset="UTF-8", bgcolor="white", fontname="DejaVu Sans", fontsize=16, labelloc=t, label="Интерфейс и нативный мост", pad="0.22", nodesep="0.25", ranksep="0.55", splines=polyline, dpi=300];
node [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#111827", penwidth=1.1];
edge [fontname="DejaVu Sans", fontsize=9, color="#334155", fontcolor="#111827", penwidth=1.1];
"pull_refresh.PullRefresh" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>pull_refresh.PullRefresh</B><BR/>base: ConstrainedControl [external]</TD></TR><TR><TD ALIGN="LEFT">content<BR ALIGN="LEFT"/>onRefresh<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">__init__(content, onRefresh)<BR ALIGN="LEFT"/>_get_children()<BR ALIGN="LEFT"/>_get_control_name()<BR ALIGN="LEFT"/>_refresh(event)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"secure_device.ProtectedSession" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>secure_device.ProtectedSession</B><BR/>base: ft.Control [external]</TD></TR><TR><TD ALIGN="LEFT">_lock : lock<BR ALIGN="LEFT"/>_pending : dict<BR ALIGN="LEFT"/>_serial : lock<BR ALIGN="LEFT"/>_uiPending : NoneType<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">__init__()<BR ALIGN="LEFT"/>_get_control_name()<BR ALIGN="LEFT"/>_received(event)<BR ALIGN="LEFT"/>call(operation, value, stillActive)<BR ALIGN="LEFT"/>delete()<BR ALIGN="LEFT"/>read()<BR ALIGN="LEFT"/>requestUi(operation, value, callback)<BR ALIGN="LEFT"/>write(value)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"views.discovery.Masonry" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>views.discovery.Masonry</B><BR/>base: ft.Row [external]</TD></TR><TR><TD ALIGN="LEFT">controls : list<BR ALIGN="LEFT"/>count : int<BR ALIGN="LEFT"/>items : list<BR ALIGN="LEFT"/>pageRef<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">__init__(page)<BR ALIGN="LEFT"/>reflow(force)<BR ALIGN="LEFT"/>setItems(items)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
