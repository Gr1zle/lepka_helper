digraph UML {
graph [rankdir=LR, charset="UTF-8", bgcolor="white", fontname="DejaVu Sans", fontsize=16, labelloc=t, label="Клиент: сообщество и уведомления", pad="0.22", nodesep="0.25", ranksep="0.55", splines=polyline, dpi=300];
node [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#111827", penwidth=1.1];
edge [fontname="DejaVu Sans", fontsize=9, color="#334155", fontcolor="#111827", penwidth=1.1];
"api_client.ApiError" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>api_client.ApiError</B><BR/>base: Exception [external]</TD></TR><TR><TD ALIGN="LEFT">statusCode : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">__init__(message, statusCode)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"challenge_gateway.ChallengeClient" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>challenge_gateway.ChallengeClient</B></TD></TR><TR><TD ALIGN="LEFT">&#160;</TD></TR><TR><TD ALIGN="LEFT">create(title, rules, deadline, startsOn, theme, resultMode)<BR ALIGN="LEFT"/>detail(challengeId, offset, sort)<BR ALIGN="LEFT"/>finish(challengeId, state, reason, winnerPostId)<BR ALIGN="LEFT"/>listing(mode, offset)<BR ALIGN="LEFT"/>noticeSummary()<BR ALIGN="LEFT"/>notices(offset, kind, unread)<BR ALIGN="LEFT"/>profile()<BR ALIGN="LEFT"/>readAllNotices()<BR ALIGN="LEFT"/>readNotice(noticeId)<BR ALIGN="LEFT"/>submit(challengeId, postId)<BR ALIGN="LEFT"/>vote(challengeId, postId, liked)<BR ALIGN="LEFT"/>withdraw(challengeId)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"community_gateway.CommunityClient" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>community_gateway.CommunityClient</B></TD></TR><TR><TD ALIGN="LEFT">apiUrl : str<BR ALIGN="LEFT"/>publicationKeys : dict<BR ALIGN="LEFT"/>remote<BR ALIGN="LEFT"/>user<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">__init__(user)<BR ALIGN="LEFT"/>copyProject(postId)<BR ALIGN="LEFT"/>copyRecipe(postId, mixtureIndex)<BR ALIGN="LEFT"/>deleteComment(commentId)<BR ALIGN="LEFT"/>deletePost(postId)<BR ALIGN="LEFT"/>editComment(commentId, text)<BR ALIGN="LEFT"/>exportLocalPost(localPostId)<BR ALIGN="LEFT"/>getComments(postId)<BR ALIGN="LEFT"/>getCommentsPage(postId, offset, limit)<BR ALIGN="LEFT"/>getLocalPosts()<BR ALIGN="LEFT"/>getPhoto(photoId)<BR ALIGN="LEFT"/>getPost(postId)<BR ALIGN="LEFT"/>getPostDetail(postId)<BR ALIGN="LEFT"/>getPosts(mine, search)<BR ALIGN="LEFT"/>getPostsPage(mine, query, category, sort, offset, limit)<BR ALIGN="LEFT"/>getState(postId)<BR ALIGN="LEFT"/>getThumbnail(photoId)<BR ALIGN="LEFT"/>getWorkshop(postId)<BR ALIGN="LEFT"/>isLiked(item)<BR ALIGN="LEFT"/>publishPost(titleText, descriptionText, categoryName, tagsText, photoFiles,<BR ALIGN="LEFT"/>&#160;&#160;challengeId)<BR ALIGN="LEFT"/>publishProject(projectId, titleText, descriptionText, categoryName,<BR ALIGN="LEFT"/>&#160;&#160;tagsText, resultStepId, otherStepIds, projectMixtureIds,<BR ALIGN="LEFT"/>&#160;&#160;workshopInfo, challengeId)<BR ALIGN="LEFT"/>request(method, path, payload, personal)<BR ALIGN="LEFT"/>saveComment(postId, text, replyToId)<BR ALIGN="LEFT"/>saveState(postId, state)<BR ALIGN="LEFT"/>sendPublication(payload)<BR ALIGN="LEFT"/>toggleLike(postId)<BR ALIGN="LEFT"/>userStats()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"moderation_gateway.ModerationClient" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>moderation_gateway.ModerationClient</B></TD></TR><TR><TD ALIGN="LEFT">apiUrl : str<BR ALIGN="LEFT"/>remote<BR ALIGN="LEFT"/>user<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">__init__(user)<BR ALIGN="LEFT"/>access()<BR ALIGN="LEFT"/>audit(offset)<BR ALIGN="LEFT"/>call(method, path, payload, local)<BR ALIGN="LEFT"/>changeUser(userId, reason, blocked, role)<BR ALIGN="LEFT"/>deleteRole(code, reason)<BR ALIGN="LEFT"/>deleteUser(userId, reason)<BR ALIGN="LEFT"/>myReports(offset)<BR ALIGN="LEFT"/>remove(targetType, targetId, reason)<BR ALIGN="LEFT"/>report(targetType, targetId, reason)<BR ALIGN="LEFT"/>reports(status, offset)<BR ALIGN="LEFT"/>resolve(reportId, status, reason)<BR ALIGN="LEFT"/>roles()<BR ALIGN="LEFT"/>saveRole(code, title, permissions, reason, create)<BR ALIGN="LEFT"/>users(query, offset)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"notification_center.NoticeCenter" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>notification_center.NoticeCenter</B></TD></TR><TR><TD ALIGN="LEFT">community<BR ALIGN="LEFT"/>user<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">__init__(user)<BR ALIGN="LEFT"/>local(source, unread)<BR ALIGN="LEFT"/>noticeSummary()<BR ALIGN="LEFT"/>notices(offset, kind, unread, source)<BR ALIGN="LEFT"/>readAllNotices()<BR ALIGN="LEFT"/>readNotice(noticeId)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"challenge_gateway.ChallengeClient" -> "moderation_gateway.ModerationClient" [arrowhead="empty", arrowtail="none"];
"challenge_gateway.ChallengeClient" -> "notification_center.NoticeCenter" [arrowhead="diamond", arrowtail="none", fontcolor="#111827", label="community", style="solid"];
}
