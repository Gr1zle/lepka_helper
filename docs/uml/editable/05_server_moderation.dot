digraph UML {
graph [rankdir=LR, charset="UTF-8", bgcolor="white", fontname="DejaVu Sans", fontsize=16, labelloc=t, label="API: модерация и роли", pad="0.22", nodesep="0.25", ranksep="0.55", splines=polyline, dpi=300];
node [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#111827", penwidth=1.1];
edge [fontname="DejaVu Sans", fontsize=9, color="#334155", fontcolor="#111827", penwidth=1.1];
"backend.moderation.MaterialInput" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>backend.moderation.MaterialInput</B></TD></TR><TR><TD ALIGN="LEFT">targetId : int<BR ALIGN="LEFT"/>targetType : str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">&#160;</TD></TR></TABLE>>];
"backend.moderation.ReasonInput" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>backend.moderation.ReasonInput</B><BR/>base: BaseModel [external]</TD></TR><TR><TD ALIGN="LEFT">model_config<BR ALIGN="LEFT"/>reason : str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">&#160;</TD></TR></TABLE>>];
"backend.moderation.ResolveInput" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>backend.moderation.ResolveInput</B></TD></TR><TR><TD ALIGN="LEFT">status : str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">&#160;</TD></TR></TABLE>>];
"backend.moderation.RoleInput" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>backend.moderation.RoleInput</B></TD></TR><TR><TD ALIGN="LEFT">permissions : list[str]<BR ALIGN="LEFT"/>title : str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">&#160;</TD></TR></TABLE>>];
"backend.moderation.UserChangeInput" [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><B>backend.moderation.UserChangeInput</B></TD></TR><TR><TD ALIGN="LEFT">blocked : bool | None<BR ALIGN="LEFT"/>role : str | None<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">&#160;</TD></TR></TABLE>>];
"backend.moderation.MaterialInput" -> "backend.moderation.ReasonInput" [arrowhead="empty", arrowtail="none"];
"backend.moderation.ResolveInput" -> "backend.moderation.ReasonInput" [arrowhead="empty", arrowtail="none"];
"backend.moderation.RoleInput" -> "backend.moderation.ReasonInput" [arrowhead="empty", arrowtail="none"];
"backend.moderation.UserChangeInput" -> "backend.moderation.ReasonInput" [arrowhead="empty", arrowtail="none"];
}
